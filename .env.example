# ─────────────────────────────────────────────────────────
#  Knowledge Assistant — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# Hugging Face API token (required for gated / private models)
# Get yours at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your_hf_token_here

# Embedding model (sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM model (Hugging Face model name)
LLM_MODEL=google/flan-t5-large

# FAISS index path
FAISS_INDEX_PATH=data/faiss_index

# Chunk size and overlap for text splitting
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Number of top-k chunks to retrieve
TOP_K=5
